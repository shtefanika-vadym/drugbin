# `npm start` (local dev).
# REACT_APP_API_URL       -> the drugbin-cf Worker (auth, admin console, hospital overview).
#   Override with .env.development.local to hit a local `wrangler dev` on http://localhost:8787.
REACT_APP_API_URL=https://api.dev.drugbin.ro

# REACT_APP_DRUGBIN_API_BASE_URL -> the legacy dashboard backend (Statistici / Gestionare /
#   Documente). Leave unset if you don't run it; those pages then have no data source.
# REACT_APP_DRUGBIN_API_BASE_URL=
